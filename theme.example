# netline theme. Copy to ~/.config/netline/theme and edit —
# the panel rereads the file right after you save it, no restart needed.
#
# Format: name = #RRGGBB or #RRGGBBAA (AA is opacity: ff solid, 00 invisible).
# Lines can be removed: anything missing from the file comes from config.zig.

# panel
background = #1e1e2eeb
border     = #45475a        # visible if border_width > 0 in config.zig
hover      = #ffffff1f      # highlight of the button under the pointer

# launcher
launcher   = #cdd6f4

# mango tags
tag_active      = #89b4fa
tag_occupied    = #cdd6f4
tag_empty       = #585b70
tag_urgent      = #f38ba8
tag_active_text = #1e1e2e  # digit on the active tag (tag_style = .numbers)

# clock
clock = #cdd6f4

# Wi-Fi
wifi          = #cdd6f4     # lit arcs
wifi_inactive = #585b70     # unlit arcs
wifi_off      = #f38ba8     # strike-through when the radio is off

# Bluetooth
bluetooth_on        = #cdd6f4
bluetooth_connected = #89b4fa
bluetooth_off       = #585b70

# wallpaper and power
wallpaper = #cdd6f4
power     = #f38ba8

# desktop: color under the wallpaper (until one is chosen, and the borders in fit mode)
desktop = #11111b

# all menus: zwifi, zbt, zwall, zpower, zcal
menu_background  = #1e1e2ef2
menu_backdrop    = #00000059    # screen dimming around the menu
menu_text        = #cdd6f4
menu_muted       = #7f849c
menu_accent      = #89b4fa
menu_accent_text = #1e1e2e      # text on the blue button
menu_field       = #313244      # input fields and secondary buttons
menu_border      = #45475a
menu_hover       = #ffffff14
menu_error       = #f38ba8
