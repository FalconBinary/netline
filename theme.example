# Тема zpanel. Скопируйте в ~/.config/zpanel/theme и меняйте —
# панель перечитает файл сразу после сохранения, перезапуск не нужен.
#
# Формат: имя = #RRGGBB или #RRGGBBAA (AA — непрозрачность: ff — сплошной, 00 — невидимый).
# Строки можно удалять: всё, чего нет в файле, берётся из config.zig.

# панель
background = #1e1e2eeb
border     = #45475a        # видна, если border_width > 0 в config.zig
hover      = #ffffff1f      # подсветка кнопки под курсором

# лаунчер
launcher   = #cdd6f4

# теги mango
tag_active      = #89b4fa
tag_occupied    = #cdd6f4
tag_empty       = #585b70
tag_urgent      = #f38ba8
tag_active_text = #1e1e2e  # цифра на активном теге (tag_style = .numbers)

# часы
clock = #cdd6f4

# Wi-Fi
wifi          = #cdd6f4     # горящие дуги
wifi_inactive = #585b70     # негорящие дуги
wifi_off      = #f38ba8     # перечёркивание, когда радио выключено

# Bluetooth
bluetooth_on        = #cdd6f4
bluetooth_connected = #89b4fa
bluetooth_off       = #585b70

# обои и питание
wallpaper = #cdd6f4
power     = #f38ba8

# рабочий стол: цвет под обоями (пока обои не выбраны, и поля в режиме fit)
desktop = #11111b

# все меню: zwifi, zbt, zwall, zpower, zcal
menu_background  = #1e1e2ef2
menu_backdrop    = #00000059    # затемнение экрана вокруг меню
menu_text        = #cdd6f4
menu_muted       = #7f849c
menu_accent      = #89b4fa
menu_accent_text = #1e1e2e      # текст на синей кнопке
menu_field       = #313244      # поля ввода и вторичные кнопки
menu_border      = #45475a
menu_hover       = #ffffff14
menu_error       = #f38ba8
